{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": false,
        "concat_space": {
            "spacing": "none"
        },
        "not_operator_with_successor_space": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "php_unit_method_casing": false
    },
    "exclude": [
        "vendor"
    ]
}
